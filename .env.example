# Copy to `.env` in the repo root. See backend/infrastructure/README.md for CDK deploy.

# Local
DYNAMODB_TABLE_NAME=streammeo
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=ap-south-1
REDIS_URL=redis://localhost:6379
PORT=3001
FRONTEND_URL=http://localhost:5173
# Comma-separated origins, or * for any (embeddable chat widget on customer sites)
WIDGET_ALLOWED_ORIGINS=*
JWT_SECRET=change-me-in-production-change-me
VITE_API_URL=

# Optional — set before CDK deploy (baked into Lambda)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# BREVO_API_KEY=
# BREVO_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# CDK_DEFAULT_ACCOUNT=
# CDK_DEFAULT_REGION=ap-south-1

# Optional — frontend (Vite)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_RAZORPAY_KEY_ID=

# After CDK deploy (npm run postdeploy)
# VITE_API_URL=
# APPSYNC_GRAPHQL_URL=
# APPSYNC_API_KEY=
# VITE_APPSYNC_GRAPHQL_URL=
# VITE_APPSYNC_API_KEY=
# UPLOADS_BUCKET=
# UPLOADS_CDN_URL=
# EMAIL_QUEUE_URL=
