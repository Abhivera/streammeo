# Sarvam AI
SARVAM_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# DynamoDB (AWS)
AWS_REGION=us-east-1
# Optional explicit credentials — omit on EC2/ECS with IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For DynamoDB Local: http://localhost:8000
DYNAMODB_ENDPOINT=
# Table names: `${prefix}Users`, `${prefix}Workspaces`, … — see docs/dynamodb-tables.md
DYNAMODB_TABLE_PREFIX=VoiceWidget

# Auth
JWT_SECRET=change-me-in-production

# Tavily (optional — enables `web_search` tool for Claude)
TAVILY_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App
PORT=3001
FRONTEND_URL=http://localhost:5173
WIDGET_ALLOWED_ORIGINS=*
