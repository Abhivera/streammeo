# =============================================================================
# Streammeo — shared env (copy to `.env` in the repo root)
# =============================================================================
# This is the ONLY file shared by the two projects:
#   - backend/  loads it via `tsx --env-file=../.env`
#   - frontend/ loads VITE_* from it via Vite (envDir = ..)
# In AWS, the backend vars are set as Lambda environment variables by the CDK stack.
# On Vercel, set the VITE_* vars in Project → Settings → Environment Variables.

# --- AWS region (single region for every service) ---
AWS_REGION=ap-south-1

# --- Voice + LLM (Amazon Bedrock + Transcribe + Polly) ---
# Bedrock model / inference-profile id. ap-south-1 uses the `apac.` cross-region profiles.
# Enable model access in the Bedrock console first.
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20240620-v1:0
# BCP-47 language for Amazon Transcribe streaming (e.g. en-US, en-IN)
TRANSCRIBE_LANGUAGE_CODE=en-US
# Amazon Polly voice + engine (e.g. Joanna/Matthew = en-US, Kajal = en-IN)
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# --- S3 (synthesized TTS audio, served via presigned URLs) ---
# Set to the CDK output AudioBucketName after deploy.
AUDIO_BUCKET=
# AUDIO_URL_TTL_SECONDS=3600

# --- DynamoDB ---
# DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_USERS_TABLE=streammeo-users
DYNAMODB_WORKSPACES_TABLE=streammeo-workspaces
DYNAMODB_SESSIONS_TABLE=streammeo-sessions
DYNAMODB_MESSAGES_TABLE=streammeo-messages
DYNAMODB_TOOL_CALLS_TABLE=streammeo-tool-calls
DYNAMODB_FAQS_TABLE=streammeo-faqs

# --- AppSync (realtime transcript/state fan-out) ---
# Set from CDK outputs GraphqlApiUrl / GraphqlApiKey after deploy.
APPSYNC_GRAPHQL_URL=
APPSYNC_API_KEY=

# --- Auth ---
JWT_SECRET=change-me-in-production-change-me
# Optional: paste Firebase service account JSON (one line) to enable POST /api/v1/auth/firebase-session / Google sign-in
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- HTTP (local dev server) ---
PORT=3001
FRONTEND_URL=http://localhost:5173
WIDGET_ALLOWED_ORIGINS=*

# =============================================================================
# Frontend (Vite) — only VITE_* vars are exposed to the browser bundle.
# =============================================================================
# Leave VITE_API_URL empty in local dev to use the Vite proxy (/api/v1 -> :3001).
# On Vercel set VITE_API_URL to the API Gateway origin (no trailing slash); REST
# paths are /api/v1/... (the client adds /api/v1 automatically).
VITE_API_URL=
# Realtime transcript/state via AppSync (from CDK outputs GraphqlApiUrl / GraphqlApiKey):
VITE_APPSYNC_GRAPHQL_URL=
VITE_APPSYNC_API_KEY=
# Where the embeddable widget bundle is hosted (built in backend/widget). Leave
# empty to use a same-origin /widget.js (drop a built copy in frontend/public).
VITE_WIDGET_URL=
# Optional — Google sign-in (only if you enabled Firebase on the backend):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
