# =============================================================================
# Streammeo — shared env (copy to `.env` in the repo root)
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/streammeo

# --- Redis (presence + queues) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me-in-production-change-me

# --- HTTP ---
PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Email (Brevo) ---
# BREVO_API_KEY=
# BREVO_WEBHOOK_SECRET=

# --- Billing (Razorpay) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# VITE_RAZORPAY_KEY_ID=   # same as RAZORPAY_KEY_ID (public key for checkout UI)

# --- AI (optional — falls back to template draft without key) ---
# ANTHROPIC_API_KEY=

# --- AppSync (webhook realtime fan-out — set after CDK deploy) ---
# APPSYNC_GRAPHQL_URL=
# APPSYNC_API_KEY=
# VITE_APPSYNC_GRAPHQL_URL=   # same as APPSYNC_GRAPHQL_URL (agent console subscriptions)
# VITE_APPSYNC_API_KEY=       # same as APPSYNC_API_KEY

# =============================================================================
# Frontend (Vite) — only VITE_* vars are exposed to the browser bundle.
# =============================================================================
# Leave empty in local dev to use the Vite proxy (/api/v1 -> :3001).
VITE_API_URL=
