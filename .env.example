# =============================================================================
# Streammeo — backend / Docker (copy to `.env` in the repo root)
# =============================================================================
# Loaded by: apps/backend (tsx --env-file=../../.env). Frontend uses apps/frontend/.env for VITE_*.

# --- Voice + LLM ---
# Deepgram (speech-to-text + text-to-speech)
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-2
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Groq (chat completions + tools)
GROQ_API_KEY=

# --- Database ---
# MongoDB (database name from URI path unless MONGODB_DB_NAME is set)
MONGODB_URI=mongodb://127.0.0.1:27017/streammeo
# MONGODB_DB_NAME=streammeo

# --- Auth ---
JWT_SECRET=change-me-in-production
# Optional: paste Firebase service account JSON (one line) to enable POST /api/v1/auth/firebase-session / Google sign-in
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Optional integrations ---
# Tavily — enables web_search tool for the LLM when set
TAVILY_API_KEY=

# --- HTTP ---
PORT=3001
FRONTEND_URL=http://localhost:5173
WIDGET_ALLOWED_ORIGINS=*

# --- Frontend build (Vite) — put these in apps/frontend/.env, not here, unless your tooling merges them ---
# VITE_API_URL=https://your-api.example.com
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
