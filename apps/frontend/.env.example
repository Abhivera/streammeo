# =============================================================================
# Local dev
# =============================================================================
# Database and server secrets live in the repo root `.env` (backend only), e.g. MONGODB_URI.
#
# Leave VITE_API_URL empty to use the Vite proxy (vite.config.ts → localhost:3001).
# To hit the API directly in dev: VITE_API_URL=http://127.0.0.1:3001

# =============================================================================
# Vercel (Project → Settings → Environment Variables)
# =============================================================================
# Add these for Production (and Preview if you use preview deploys).
# Vite only exposes variables prefixed with VITE_. Redeploy after changing them.
#
# Required on Vercel (no dev proxy there):
#   VITE_API_URL=https://your-backend-host.example.com
#   - No trailing slash. Must match where Express/Socket.IO actually run (Railway, Fly, VPS, etc.).
#
# Optional — Google sign-in (only if you enabled Firebase on the backend):
#   VITE_FIREBASE_API_KEY=
#   VITE_FIREBASE_AUTH_DOMAIN=
#   VITE_FIREBASE_PROJECT_ID=
#   VITE_FIREBASE_APP_ID=
#
# Firebase Console → Authentication → Settings → Authorized domains:
#   add your-site.vercel.app and your custom domain.
#
# Backend .env must allow this origin, e.g.:
#   FRONTEND_URL=https://your-site.vercel.app
#   WIDGET_ALLOWED_ORIGINS=https://your-site.vercel.app  (or comma-separated list)
# =============================================================================

VITE_API_URL=

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
