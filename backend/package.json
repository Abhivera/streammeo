{
  "name": "@streammeo/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const d of ['dist','infrastructure/cdk.out','infrastructure/dist']) rmSync(d,{recursive:true,force:true});\"",
    "lint": "tsc -p tsconfig.json",
    "db:create-table": "npm run -w @streammeo/db create-table",
    "db:seed": "npm run -w @streammeo/db seed",
    "cdk:bootstrap": "npm run bootstrap --prefix infrastructure",
    "cdk:synth": "npm run synth --prefix infrastructure",
    "cdk:diff": "npm run diff --prefix infrastructure",
    "cdk:deploy": "npm run deploy --prefix infrastructure",
    "cdk:destroy": "npm run destroy --prefix infrastructure",
    "cdk:destroy:interactive": "npm run destroy:interactive --prefix infrastructure"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@streammeo/db": "*",
    "@streammeo/shared": "*",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.1",
    "firebase-admin": "^14.0.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
