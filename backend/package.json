{
  "name": "@streammeo/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "widget"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "start:lambda:api": "tsx --env-file=../.env src/lambda/api-handler.ts",
    "start:lambda:voice": "tsx --env-file=../.env src/lambda/voice-handler.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "db:seed": "npm run -w @streammeo/db seed",
    "widget:build": "npm run -w @streammeo/widget build",
    "widget:dev": "npm run -w @streammeo/widget dev",
    "infra:install": "npm --prefix infrastructure install",
    "infra:bootstrap": "npm --prefix infrastructure run bootstrap",
    "infra:synth": "npm run widget:build && npm --prefix infrastructure run synth",
    "infra:deploy": "npm run widget:build && npm --prefix infrastructure run deploy",
    "infra:destroy": "npm --prefix infrastructure run destroy"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.908.0",
    "@aws-sdk/client-polly": "^3.908.0",
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/client-transcribe-streaming": "^3.908.0",
    "@aws-sdk/s3-request-presigner": "^3.908.0",
    "@streammeo/db": "*",
    "@streammeo/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.9.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "serverless-http": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
