{
  "name": "@streammeo/infrastructure",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "synth": "cdk synth --outputs-file cdk-outputs.json",
    "deploy": "cdk deploy --all --require-approval never --outputs-file cdk-outputs.json",
    "destroy": "cdk destroy --all --force",
    "bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.178.2",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "aws-cdk": "^2.1003.0",
    "esbuild": "^0.24.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
