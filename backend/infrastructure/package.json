{
  "name": "@streammeo/infrastructure",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare:assets": "node scripts/predeploy.mjs",
    "predeploy": "npm run prepare:assets",
    "presynth": "npm run prepare:assets",
    "prediff": "npm run prepare:assets",
    "bootstrap": "node scripts/run-cdk.mjs bootstrap",
    "synth": "node scripts/run-cdk.mjs synth",
    "diff": "node scripts/run-cdk.mjs diff",
    "deploy": "node scripts/run-cdk.mjs deploy",
    "postdeploy": "node scripts/print-outputs.mjs",
    "destroy": "node scripts/run-cdk.mjs destroy --force",
    "destroy:interactive": "node scripts/run-cdk.mjs destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.178.2",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "aws-cdk": "^2.1003.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
