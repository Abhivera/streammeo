{
  "name": "streammeo",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run -w @streammeo/backend dev",
    "dev:frontend": "npm run -w @streammeo/frontend dev",
    "dev:widget": "npm run -w @streammeo/widget dev",
    "build": "npm run -ws build",
    "db:seed": "npm run -w @streammeo/db seed",
    "lint": "npm run -w @streammeo/backend lint && npm run -w @streammeo/frontend lint"
  }
}
